generator client {
 provider = "prisma-client-js"
 output   = "./src/generated/client"
}
datasource db {
 provider = "mysql"
 url      = env("DATABASE_URL")
}
// Bảng Người dùng (Chủ tiệm, Nhân viên, Khách hàng)
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  fullName  String?
  role      String   @default("USER") // ADMIN, STAFF, USER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Category {
  id          Int       @id @default(autoincrement())
  name        String    // Tên danh mục (VD: Thực phẩm chức năng)
  slug        String    @unique // URL (VD: thuc-pham-chuc-nang)
  image       String?   // Ảnh đại diện danh mục
  description String?   @db.Text
  status      Boolean   @default(true) // Ẩn/Hiện danh mục
  products    Product[] 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
model Product {
  id              Int      @id @default(autoincrement())
  // --- THÔNG TIN CƠ BẢN ---
  name            String
  slug            String   @unique // Để làm URL đẹp: /san-pham/panadol-extra
  categoryId      Int?     // Nếu bạn đã có model Category thì nối relation vào đây
  price           Decimal  @db.Decimal(10, 0) // Dùng Decimal cho tiền tệ chính xác
  original_price  Decimal? @db.Decimal(10, 0) // Giá gốc (để hiện giảm giá)
  quantity        Int      @default(0)
  unit            String   @default("Hộp") // Hộp, Vỉ, Chai...
  image           String?  // Link ảnh chính
  gallery         String?  @db.Text // Lưu JSON mảng ảnh phụ (nếu cần)
  discount        Int      @default(0)  // % Giảm giá. Mặc định là 0
  // --- THÔNG TIN Y TẾ CHI TIẾT (QUAN TRỌNG) ---
  short_description String? @db.Text // Mô tả ngắn
  description       String? @db.LongText // Mô tả chi tiết (HTML)
  ingredients       String? @db.Text // Thành phần / Hoạt chất
  usage_dosage      String? @db.Text // Liều dùng
  contraindications String? @db.Text // Chống chỉ định
  side_effects      String? @db.Text // Tác dụng phụ
  // --- NGUỒN GỐC ---
  manufacturer      String? // Nhà sản xuất
  origin            String? // Xuất xứ (Việt Nam, Anh...)
  packaging         String? // Quy cách (Hộp 10 vỉ...)
  registration_num  String? // Số đăng ký thuốc
  // --- QUẢN TRỊ ---
  views           Int      @default(0)
  is_prescription Boolean  @default(false) // True = Thuốc kê đơn
  status          Boolean  @default(true) // True = Đang bán
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id])
}
